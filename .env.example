# Copy to .env (git-ignored). Read by `npm run dev` and `npm start` (node --env-file=.env).
# Telegram bot that posts leads to the group. Server-only: never reaches the browser.
NUXT_TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Group id from https://api.telegram.org/bot<TOKEN>/getUpdates (message.chat.id). Groups are negative, supergroups -100…
NUXT_TELEGRAM_CHAT_ID=-1001234567890

# Where the contact form POSTs. Default /api/lead (this server). Build-time value for the static client.
# Only needed if you deploy the site as static files and the Cloudflare worker separately (workers/lead-relay/README.md).
# NUXT_PUBLIC_LEAD_ENDPOINT=https://lead-relay.example.workers.dev/lead
