{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/guard-agent-model.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run generate)",
      "Bash(npm run agents:check)",
      "Bash(npm run sdlc:status)",
      "Bash(npx playwright test:*)",
      "Bash(git diff:*)",
      "Bash(git status)"
    ]
  }
}
